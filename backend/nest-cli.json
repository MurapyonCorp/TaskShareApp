{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "**/*.hbs" },
      { "include": "**/*.yaml" },
      { "include": "**/*.json" }
    ],
    "watchAssets": true
  }
}
